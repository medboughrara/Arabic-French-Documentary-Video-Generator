  "audio_cues": [
    {
      "id": "scene1",
      "start": 1.0,
      "subtitle": "من الكفاءات التونسية التي صنعت مسارًا مهنيًا دوليًا متميزًا، يبرز اسم المهندس هشام جوابر، ابن جهة قابس، الذي جمع بين التكوين الهندسي الرفيع والخبرة الاستراتيجية في كبرى المؤسسات الدولية.",
      "parts": [
        {
          "name": "p1",
          "text": "مِنَ الكَفَاءَاتِ التُّونُسِيَّةِ الَّتِي صَنَعَتْ مَسَارًا مِهْنِيًّا دَوْلِيًّا مُتَمَيِّزًا، يَبْرُزُ اسْمُ المُهَنْدِسِ هِشَام جْوَابِر، ابْنِ جِهَةِ",
          "threshold": 200,
          "pad_before": 1000,
          "pad_after": 1200
        },
        {
          "name": "p_g",
          "text": "جَابِسْ",
          "voice": "ar-EG-ShakirNeural",
          "rate": "+10%",
          "pitch": "-2Hz",
          "af": "volume=0.82",
          "threshold": 120,
          "pad_before": 1800,
          "pad_after": 1800,
          "pause_before": 0.10,
          "pause_after": 0.18
        },
        {
          "name": "p2",
          "text": "الَّذِي جَمَعَ بَيْنَ التَّكْوِينِ الهَنْدَسِيِّ الرَّفِيعِ، وَالخِبْرَةِ الاسْتِرَاتِيجِيَّةِ فِي كُبْرَى المُؤَسَّسَاتِ الدَّوْلِيَّة.",
          "threshold": 200,
          "pad_before": 1500,
          "pad_after": 2000
        }
      ]
    },
    {
      "id": "scene2",
      "start": 16.0,
      "tts_text": "تَخَرَّجَ المُهَنْدِسُ هِشَام جْوَابِر مِنَ المَدْرَسَةِ الوَطَنِيَّةِ العُلْيَا لِلْجُسُورِ وَالطُّرُقِ بِفَرَنْسَا، إِحْدَى أَعْرَقِ المُؤَسَّسَاتِ الهَنْدَسِيَّةِ فِي أُورُوبَّا، لِيَنْطَلِقَ فِي مَسِيرَةٍ مِهْنِيَّةٍ تَمْتَدُّ لِأَكْثَرَ مِنْ ثَلَاثِينَ عَامًا، كَرَّسَ خِلَالَهَا خِبْرَتَهُ لِمَجَالَاتِ الاسْتِشَارَاتِ الاسْتِرَاتِيجِيَّةِ، وَالتَّحَوُّلِ المُؤَسَّسِيِّ، وَإِعَادَةِ الهَيْكَلَة.",
      "subtitle": "تخرّج المهندس هشام جوابر من المدرسة الوطنية العليا للجسور والطرق بفرنسا، إحدى أعرق المؤسسات الهندسية في أوروبا، لينطلق في مسيرة مهنية تمتد لأكثر من ثلاثين عامًا، كرّس خلالها خبرته لمجالات الاستشارات الاستراتيجية، والتحوّل المؤسسي، وإعادة الهيكلة."
    },
    {
      "id": "scene3a",
      "start": 35.2,
      "tts_text": "خِلَالَ مَسِيرَتِهِ، تَوَلَّى مَسْؤُولِيَّاتٍ قِيَادِيَّةً ضِمْنَ مَجْمُوعَاتٍ دَوْلِيَّةٍ كُبْرَى، وَسَاهَمَ فِي قِيَادَةِ وَمُوَاكَبَةِ بَرَامِجَ لِلْإِصْلَاحِ وَالتَّحَوُّلِ الاقْتِصَادِيِّ وَالمُؤَسَّسِيِّ خَارِجَ حُدُودِ الوَطَن.",
      "subtitle": "خلال مسيرته، تولّى مسؤوليات قيادية ضمن مجموعات دولية كبرى، وساهم في قيادة ومواكبة برامج للإصلاح والتحوّل الاقتصادي والمؤسسي خارج حدود الوطن."
    },
    {
      "id": "scene3b",
      "start": 47.0,
      "tts_text": "وَقَدِ امْتَدَّتْ تَجَارِبُهُ المِهْنِيَّةُ إِلَى عَدَدٍ مِنَ المَحَطَّاتِ الدَّوْلِيَّةِ البَارِزَةِ، مِنْ بَيْنِهَا المَمْلَكَةُ المُتَّحِدَةُ، وَبُولَنْدَا، وَسِنْغَافُورَة، حَيْثُ رَاكَمَ خِبْرَةً مُتَنَوِّعَةً فِي فَهْمِ التَّحَدِّيَاتِ الاقْتِصَادِيَّةِ، وَإِدَارَةِ التَّحَوُّلَاتِ، وَتَحْوِيلِ الرُّؤَى الاسْتِرَاتِيجِيَّةِ إِلَى بَرَامِجِ عَمَلٍ قَابِلَةٍ لِلتَّنْفِيذ.",
      "subtitle": "وقد امتدت تجاربه المهنية إلى عدد من المحطات الدولية البارزة، من بينها المملكة المتحدة، وبولندا، وسنغافورة، حيث راكم خبرة متنوعة في فهم التحديات الاقتصادية، وإدارة التحوّلات، وتحويل الرؤى الاستراتيجية إلى برامج عمل قابلة للتنفيذ."
    },
    {
      "id": "scene4a",
      "start": 65.5,
      "tts_text": "وَمِنْ حَصِيلَةِ هَذِهِ التَّجْرِبَةِ الدَّوْلِيَّةِ، يَأْتِي مُؤَلَّفُهُ «المِيثَاق – 108 رَافِعَةً لِإِقْلَاعِ تُونُس»، لِيَطْرَحَ رُؤْيَةً عَمَلِيَّةً لِمُسْتَقْبَلِ البِلَادِ، تَتَجَاوَزُ تَشْخِيصَ الصُّعُوبَاتِ إِلَى اقْتِرَاحِ حُلُولٍ وَآلِيَّاتِ تَنْفِيذٍ وَاضِحَة.",
      "subtitle": "ومن حصيلة هذه التجربة الدولية، يأتي مؤلّفه «الميثاق – 108 رافعة لإقلاع تونس»، ليطرح رؤية عملية لمستقبل البلاد، تتجاوز تشخيص الصعوبات إلى اقتراح حلول وآليات تنفيذ واضحة."
    },
    {
      "id": "scene4b",
      "start": 80.5,
      "tts_text": "يَتَضَمَّنُ الكِتَابُ 108 رَافِعَةً لِلْإِصْلَاحِ وَالتَّطْوِيرِ، مُوَزَّعَةً عَلَى مَشَارِيعَ وَمُبَادَرَاتٍ، مَعَ تَحْدِيدِ التَّكَالِيفِ وَالآجَالِ وَالمَسْؤُولِيَّاتِ، فِي مُحَاوَلَةٍ جَادَّةٍ لِلْإِجَابَةِ عَنْ سُؤَالٍ جَوْهَرِيٍّ: كَيْفَ نَنْتَقِلُ مِنَ الاسْتِرَاتِيجِيَّةِ إِلَى الإِنْجَاز؟",
      "subtitle": "يتضمّن الكتاب 108 رافعة للإصلاح والتطوير، موزّعة على مشاريع ومبادرات، مع تحديد التكاليف والآجال والمسؤوليات، في محاولة جادة للإجابة عن سؤال جوهري: كيف ننتقل من الاستراتيجية إلى الإنجاز؟"
    },
    {
      "id": "scene4c",
      "start": 96.1,
      "tts_text": "وَقَدْ قَدَّمَ لِهَذَا العَمَلِ الاقْتِصَادِيُّ وَوَزِيرُ المَالِيَّةِ الأَسْبَقُ الأُسْتَاذ حَكِيم بِنْ حَمُّودَةَ.",
      "subtitle": "وقد قدّم لهذا العمل الاقتصادي ووزير المالية الأسبق الأستاذ حكيم بن حمودة."
    },
    {
      "id": "scene5a",
      "start": 102.0,
      "tts_text": "إِنَّهَا تَجْرِبَةٌ مِهْنِيَّةٌ دَوْلِيَّةٌ تَلْتَقِي مَعَ طُمُوحٍ وَطَنِيٍّ، وَرِسَالَةٌ تُؤَكِّدُ أَنَّ بِنَاءَ المُسْتَقْبَلِ لَا يَتَحَقَّقُ بِالأَفْكَارِ وَحْدَهَا، بَلْ بِالإِرَادَةِ وَالتَّخْطِيطِ وَالعَمَل.",
      "subtitle": "إنها تجربة مهنية دولية تلتقي مع طموح وطني، ورسالة تؤكد أن بناء المستقبل لا يتحقق بالأفكار وحدها، بل بالإرادة والتخطيط والعمل."
    },
    {
      "id": "scene5b",
      "start": 112.3,
      "tts_text": "المُهَنْدِسُ هِشَام جْوَابِر... خِبْرَةٌ دَوْلِيَّةٌ، وَرُؤْيَةٌ مِنْ أَجْلِ تُونُس.",
      "subtitle": "المهندس هشام جوابر... خبرة دولية، ورؤية من أجل تونس."
    }
  ],
